[TEMPLATE]
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
DATABASE_URL=sqlite:///data/conflux.db
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CONFLUX_DEMO=0
SUBREDDIT=delhi
HOURS_BACK=4

# Ingestion sources (all optional; RSS + GDELT are on by default)
NEWS_INGEST_ENABLED=1
REDDIT_INGEST_ENABLED=1
GDELT_INGEST_ENABLED=1
# NEWS_FEEDS=name|url,name2|url2          # optional override of default feeds
TARGET_SUBS=delhi,NewDelhi,india,gurgaon,noida
# DATA_GOV_API_KEY=                       # enables data.gov.in ingestion
# DATA_GOV_RESOURCE_ID=                   # single id or comma-separated list
# INFRA_EXTRA_KEYWORDS=water tank,billing # extra gate keywords (comma-separated)
# BACKFILL_GEO_ENABLED=1                  # re-geocode old unlocated threads each run
# BACKFILL_LIMIT=200                      # max threads per backfill pass
# PRUNE_UNLOCATED_ENABLED=1               # delete stale unlocated news/gov threads
# PRUNE_UNLOCATED_DAYS=45                 # age threshold for pruning
# PRUNE_UNLOCATED_LIMIT=500               # max deletions per pass
