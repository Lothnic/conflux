API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# Mapbox public token (starts with pk.) for the 3D locality preview in the
# analysis panel. Create one free at https://console.mapbox.com/account/tokens/
# and put it in frontend/.env.local. Without it the panel shows a
# "Mapbox token required" placeholder instead of the preview.
# NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_public_token_here
